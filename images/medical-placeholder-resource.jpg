<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500">
  <!-- Medical resource card placeholder -->
  <defs>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffc107;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#ff9800;stop-opacity:0.8" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="#f3f4f6"/>
  <rect x="50" y="50" width="700" height="400" fill="url(#goldGrad)" rx="10"/>
  <g opacity="0.3">
    <circle cx="400" cy="250" r="120" fill="white"/>
    <path d="M 400 150 L 420 230 L 500 250 L 420 270 L 400 350 L 380 270 L 300 250 L 380 230 Z" fill="white"/>
  </g>
  <text x="400" y="260" font-family="system-ui, sans-serif" font-size="32" fill="white" text-anchor="middle" font-weight="500">
    Resource Image
  </text>
</svg>
