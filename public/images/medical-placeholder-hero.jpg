<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="600" viewBox="0 0 1200 600">
  <!-- Medical hero placeholder with Dana-Farber blue gradient -->
  <defs>
    <linearGradient id="dfBlueGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0066cc;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#003d7a;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="1200" height="600" fill="url(#dfBlueGrad)"/>
  <g opacity="0.1">
    <!-- Abstract medical symbols -->
    <circle cx="200" cy="150" r="80" fill="white" opacity="0.3"/>
    <circle cx="1000" cy="450" r="100" fill="white" opacity="0.2"/>
    <rect x="400" y="100" width="400" height="400" fill="white" opacity="0.1" rx="20"/>
  </g>
  <text x="600" y="300" font-family="system-ui, sans-serif" font-size="48" fill="white" text-anchor="middle" font-weight="300">
    Medical Placeholder Image
  </text>
  <text x="600" y="350" font-family="system-ui, sans-serif" font-size="24" fill="white" text-anchor="middle" opacity="0.8">
    Dana-Farber Provider Education
  </text>
</svg>
